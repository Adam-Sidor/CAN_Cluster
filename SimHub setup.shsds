{
  "AutomaticReconnect": true,
  "SerialPortName": "COM3",
  "StartupDelayMs": 0,
  "IsConnecting": false,
  "IsEnabled": false,
  "LogIncomingData": true,
  "IsConnected": false,
  "BaudRate": 115200,
  "UpdateMessages": [
    {
      "Message": {
        "Expression": "'speed'+round([SpeedKmh],0)"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'rpm'+if([MaxRpm]<7000,round([Rpms],0),round([Rpms],0)*7000/[MaxRpm])"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'fuel'+round([FuelPercent],0)+'\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'handBrake' + if([Handbrake] > 0 or isnull([GameRawData.TruckValues.CurrentValues.MotorValues.BrakeValues.ParkingBrake], false), 1, 0) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if([GameRawData.TruckValues.CurrentValues.LightsValues.BeamHigh] and [EngineStarted],'lights3','lights4')+'\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if([GameRawData.TruckValues.CurrentValues.LightsValues.Beacon],'lights5','lights6')+'\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'lights' + if([GameRawData.TruckValues.CurrentValues.LightsValues.Parking],if([GameRawData.TruckValues.CurrentValues.LightsValues.BeamLow],'2','1'),'0') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'time'+right([DataCorePlugin.CurrentDateTime], 0, 11)+'\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if([GameRawData.TruckValues.CurrentValues.LightsValues.HazardWarningLights],'blinkers3',if([GameRawData.TruckValues.CurrentValues.LightsValues.BlinkerLeftActive],'blinkers1',if([GameRawData.TruckValues.CurrentValues.LightsValues.BlinkerRightActive],'blinkers2','blinkers0'))) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'cruise' + if(isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.CruiseControl], false), 1, 0) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'cruiseSpeed' + round(isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.CruiseControlSpeed.Kph], 0), 0) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.WarningValues.FuelW], false), 'ccOn275', 'ccOff275') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.WarningValues.AdBlue], false), 'ccOn643', 'ccOff643') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.WarningValues.OilPressure], false), 'ccOn212', 'ccOff212') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.WarningValues.WaterTemperature], false), 'ccOn39', 'ccOff39') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.WarningValues.BatteryVoltage], false), 'ccOn213', 'ccOff213') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.WarningValues.AirPressure], false) or isnull([GameRawData.TruckValues.CurrentValues.DashboardValues.WarningValues.AirPressureEmergency], false), 'ccOn308', 'ccOff308') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DamageValues.WheelsAvg], 0) >= 0.1, 'ccOn50', 'ccOff50') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DamageValues.Chassis], 0) >= 0.1, 'ccOn34', 'ccOff34') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TruckValues.CurrentValues.DamageValues.Chassis], 0) >= 0.3, 'ccOn21', 'ccOff21') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.JobValues.CargoValues.CargoDamage], 0) >= 0.1, 'ccOn169', 'ccOff169') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "if(isnull([GameRawData.TrailerValues01.DamageValues.Chassis], 0) >= 0.1, 'ccOn19', 'ccOff19') + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'fuelRate' + if([SpeedKmh] < 1, 0, round(isnull([DataCorePlugin.GameData.InstantConsumption_L100KM], 0) * [SpeedKmh] * 25 / 9 / 3, 0)) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 60
    }
  ],
  "OnConnectMessage": {
    "Expression": ""
  },
  "OnDisconnectMessage": {
    "Expression": ""
  },
  "DtrEnable": false,
  "RtsEnable": false,
